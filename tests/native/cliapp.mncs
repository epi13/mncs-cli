test doctor_delegates() -> (result: TestResult) {
    let cmd_raw: [byte; up_to 1024] = [100, 111, 99, 116, 111, 114];
    let act_raw: [byte; up_to 1024] = [45, 45, 97, 99, 116, 105, 111, 110];
    let act_val: [byte; up_to 1024] = [99, 104, 101, 99, 107];
    let done: CommandExit = app.dispatch(argv4(word(cmd_raw, 6), word(act_raw, 8), word(act_val, 5), token.empty_token()), 4);
    let fin: ApplicationExit = done.exit;
    return from_assertion(equals_bool(true, fin.exit_code == 2 && outcome.outcome_code(done.outcome) == 2, 5020));
}

test version_rejects_unknown_option() -> (result: TestResult) {
    let cmd_raw: [byte; up_to 1024] = [118, 101, 114, 115, 105, 111, 110];
    let opt_raw: [byte; up_to 1024] = [45, 45, 98, 111, 103, 117, 115];
    let done: CommandExit = app.dispatch(argv3(word(cmd_raw, 7), word(opt_raw, 7)), 3);
    let fin: ApplicationExit = done.exit;
    let code: bool = fin.exit_code == 64 && done.has_outcome == false;
    let hint: bool = fin.stderr[0] == 117;
    let quiet: bool = fin.stdout[0] == 0;
    return from_assertion(equals_bool(true, code && hint && quiet, 5021));
}
