test verdict_missing_outcome() -> (result: TestResult) {
    let cmd_raw: [byte; up_to 1024] = [118, 101, 114, 100, 105, 99, 116];
    let done: CommandExit = app.dispatch(argv2(word(cmd_raw, 7)), 2);
